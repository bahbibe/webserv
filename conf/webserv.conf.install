# Installed by scripts/install.sh to /etc/webserv/webserv.conf.
# Uses the FHS paths install.sh sets up: /var/www/webserv (document
# root, populated from this repo's WWW/ on first install),
# /var/log/webserv (logs), /run/webserv.pid.
#
# This is a *starting point* - edit it in place. install.sh never
# overwrites an already-installed /etc/webserv/webserv.conf, so
# changes made here after install are safe across upgrades.

pid /run/webserv.pid
error_log /var/log/webserv/error.log info
user webserv webserv

server {
    host 0.0.0.0
    listen 80
    server_name _;

    root /var/www/webserv
    index index.html
    error_page 400 /var/www/webserv/err/400.html
    error_page 403 /var/www/webserv/err/403.html
    error_page 404 /var/www/webserv/err/404.html
    error_page 405 /var/www/webserv/err/405.html
    error_page 500 /var/www/webserv/err/500.html
    error_page 501 /var/www/webserv/err/501.html
    client_max_body_size 10000000
    autoindex off

    location /uploads {
        root /var/www/webserv/uploads
        allow GET POST DELETE
        upload on
        upload_path /var/www/webserv/uploads
        autoindex on
    }

    location /cgi-bin {
        root /var/www/webserv/cgi-bin
        allow GET POST
        cgi on
        cgi_upload_path /var/www/webserv/uploads/cgi
    }
}
