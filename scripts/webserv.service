[Unit]
Description=webserv HTTP/HTTPS server
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/webserv
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure

# No User= here on purpose: webserv starts as root to bind :80/:443
# then drops privileges itself via the `user` directive (setuid, see
# src/Server/Privileges.cpp) - a systemd-level User= would fight that
# by dropping before bind() ever runs. Everything below is sandboxing
# for the root window before the drop, plus for the case where a
# config omits `user` and it stays root for the process lifetime.
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
# Paths under /etc/webserv and /var/www/webserv (minus uploads) stay
# read-only under ProtectSystem=strict - only these need write access:
# the pidfile, logs, and wherever uploads/CGI output actually land.
ReadWritePaths=/run /var/log/webserv /var/www/webserv/uploads

[Install]
WantedBy=multi-user.target
